+            </View>
+          </View>
+
+          {p.fallbackErr ? (
+            <View style={s.banner}><Text style={[type.subhead]}>宸茬敤鏈湴鍏滃簳</Text><Text style={type.caption} numberOfLines={2}>{p.fallbackErr}</Text></View>
+          ) : null}
+
+          {c ? (
+            <View style={{ gap: space.sm }} testID="phase-handoff">
+              <Text style={s.statLabel}>璁板綍 路 瀹夋帓鏁寸悊</Text>
+              <Card testID="handoff-card">
+                {p.learned ? (
+                  <Pressable onPress={() => p.onOpenRole(p.learned!.role)} style={[s.pad, s.sep, g.hstack]} testID="learned-tip">
+                    <Text style={[g.sub, { flex: 1 }]} numberOfLines={1}>瀛﹀埌锛歿p.learned.text}</Text>
+                    <Text style={[type.subhead]}>鏌ョ湅 鈥?/Text>
