+        <Text style={type.largeTitle}>浠婃棩</Text>
+        <Segmented items={[{ key: 'day', label: '浠婃棩' }, { key: 'week', label: '鏈懆' }]} value={seg} onChange={setSeg} />
+      </View>
+
+      {seg === 'week' ? (
+        <Card style={{ padding: space.lg }}><Text style={g.sub}>鏈懆瑙嗗浘鏆傛湭寮€鏀撅紱璇锋煡鐪嬪綋鍓嶈褰曘€?/Text></Card>
+      ) : (
+        <>
+          <View style={{ gap: space.md }} testID="status-panel">
+            <View style={[g.hstack, { gap: space.md }]}>
+              <Stat label="鏄ㄦ櫄鐫＄湢" value={status.sleep_hours} unit="灏忔椂" step={0.5} min={0} max={24} onChange={(n) => onChange({ ...status, sleep_hours: n })} />
+              <Stat label="浠婃櫄鍙敤" value={status.free_minutes} unit="鍒嗛挓" step={5} min={0} max={240} onChange={(n) => onChange({ ...status, free_minutes: n })} />
+            </View>
+            {p.hasBudget ? (
+              <View style={g.hstack} testID="budget-row">
+                <Stat label="鏈懆鍓╀綑棰勭畻" value={status.budget_left ?? 300} unit="鍏? step={50} min={0} max={5000} onChange={(n) => onChange({ ...status, budget_left: n })} />
+              </View>
+            ) : null}
+            <View style={[g.hstack, { flexWrap: 'wrap' }]}>
+              <Text style={[s.statLabel, { marginRight: 4 }]}>鍐扮閲屾湁</Text>
