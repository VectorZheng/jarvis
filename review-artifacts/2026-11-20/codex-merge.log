+  fallbackErr: string | null;
+};
+
+export function Today(p: Props) {
+  const [seg, setSeg] = useState<'day' | 'week'>('day');
+  const [openRole, setOpenRole] = useState<string | null>(null);
+  const [vetoOpen, setVetoOpen] = useState(true);
