/** Local iPhone testing uses app.json; store builds require an online API. */
module.exports = ({ config }) => {
  if (process.env.JARVIS_BUILD_ENV !== 'production') return config;

  const address = process.env.EXPO_PUBLIC_API_BASE;
  let backend;
  try { backend = new URL(address); } catch { /* checked below */ }
  const host = backend?.hostname.toLowerCase().replace(/^\[|\]$/g, '') || '';
  const isLocal = host === 'localhost' || host.endsWith('.localhost') || host.endsWith('.local') || !host.includes('.') ||
    /^(0|10|127)\./.test(host) || /^169\.254\./.test(host) || /^192\.168\./.test(host) || /^172\.(1[6-9]|2\d|3[01])\./.test(host) ||
    /^(::|fc|fd|fe80:)/.test(host);
  if (!backend || backend.protocol !== 'https:' || isLocal || backend.username || backend.password || backend.search || backend.hash) {
    throw new Error('TestFlight 鏋勫缓闇€瑕?EXPO_PUBLIC_API_BASE 鎸囧悜鍙叕寮€璁块棶鐨?HTTPS 鍚庣锛屼笉鑳戒娇鐢?localhost 鎴栧眬鍩熺綉鍦板潃銆?);
  }

  // LAN permission and its HTTP exception are only needed for local testing.
  const infoPlist = { ...config.ios?.infoPlist };
  delete infoPlist.NSLocalNetworkUsageDescription;
  if (infoPlist.NSAppTransportSecurity) {
    const transport = { ...infoPlist.NSAppTransportSecurity };
    delete transport.NSAllowsLocalNetworking;
    if (Object.keys(transport).length) infoPlist.NSAppTransportSecurity = transport;
    else delete infoPlist.NSAppTransportSecurity;
  }
  return { ...config, ios: { ...config.ios, infoPlist } };
};

--- app AGENT
This is an Expo/React Native mobile application. Prioritize mobile-first patterns, performance, and cross-platform compatibility.

## Expo has changed 鈥?do not trust your training data

Expo ships breaking changes every SDK release. APIs you remember are likely renamed, moved, or removed. Before writing any code that touches an Expo, EAS, or React Native API:

1. Read the major version of the `expo` package in `package.json`.
2. Fetch the matching versioned docs: `https://docs.expo.dev/versions/v<major>.0.0/`
3. For anything else, fetch https://docs.expo.dev/llms.txt 鈥?an index of all Expo docs with corrections to common LLM misconceptions. Follow its links to the specific page you need; never answer from memory.

## Commands

Use `bunx` instead of `npx` if the project uses bun (`bun.lock` present).

```bash
npx expo install <package>  # ALWAYS use instead of npm/yarn/pnpm/bun add 鈥?resolves SDK-compatible versions
npx expo start              # start the dev server
npx expo lint               # lint
npx tsc --noEmit            # typecheck
npx expo-doctor             # diagnose dependency and config issues
npx expo install --fix      # fix incompatible package versions
```

Run lint and typecheck before declaring any task done.

## Navigation & Routing

- Use **Expo Router** for all navigation. Routes live in `src/app/` 鈥?every file there is a screen, `_layout.tsx` files define navigators. Keep non-route code (components, hooks, utils) outside `src/app/`.
- Import `Link`, `router`, and `useLocalSearchParams` from `expo-router`.
- Docs: https://docs.expo.dev/router/introduction.md

## Building with EAS

Use EAS to build, sign, and submit the app in the cloud (`eas build`, `eas submit`) and to ship over-the-air updates (`eas update`) 鈥?no local Xcode or Android Studio required. Run EAS CLI as `bunx eas-cli <command>` in Bun projects, or `npx eas-cli@latest <command>` otherwise; substitute that for bare `eas` in docs examples.
Docs: https://docs.expo.dev/eas/index.md

## Rules

- If `ios/` and `android/` directories do not exist, they are generated (Continuous Native Generation). Never create or edit them by hand 鈥?configure native behavior in `app.json` and config plugins.
- Expo Go only includes its bundled native modules. After adding a library with native code, the app needs a development build: `npx expo run:ios|android` locally, or `eas build --profile development`.
- Prefer recommended Expo modules over third-party libraries, and check your available skills before adding dependencies. Docs: https://docs.expo.dev/versions/latest/index.md


