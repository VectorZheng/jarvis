+/** Boss idle lines under the orb 鈥?synced with skills/rules/idle_quotes.mjs (Crea 12). */
+export const BOSS_QUOTES: readonly string[] = [
+  '鍏堝惉瀹岋紝鍐嶅姩鎵嬨€?,
+  '灏戝仛涓€鐐癸紝鍋氬涓€鐐广€?,
+  '鐫′笉澶燂紝鍒‖鎵涖€?,
+  '浠婂ぉ鍙В鐪煎墠杩欎欢銆?,
+  '鎱紝鏄负浜嗚蛋寰楁洿绋炽€?,
+  '鐣欎竴鐐逛綑鍦扮粰鏄庡ぉ銆?,
+  '璇存竻妤氾紝姣旇寰楀閲嶈銆?,
+  '绱簡灏卞仠锛屼笉绠楄緭銆?,
+  '鎶婇毦浜嬫媶灏忓啀璧般€?,
+  '绌虹潃锛屼篃鏄竴绉嶅噯澶囥€?,
+  '鍏堥棶闇€涓嶉渶瑕侊紝鍐嶉棶鑳戒笉鑳姐€?,
+  '鎴戜細璁板緱浣犲垰鎵嶈鐨勩€?,
+];
+
+/** Meeting-state replacement (or hide entirely). */
+export const MEETING_LINE = '姝ｅ湪鏁寸悊浣犵殑瀹夋帓';
+
+export function pickQuote(exclude?: string): string {
+  const pool = exclude ? BOSS_QUOTES.filter((q) => q !== exclude) : BOSS_QUOTES;
+  const list = pool.length ? pool : BOSS_QUOTES;
+  return list[Math.floor(Math.random() * list.length)]!;
+}
