@@ -0,0 +1,168 @@
+import React from 'react';
+import { Text, TextInput, View } from 'react-native';
+import { g, Group, PrimaryButton, RoleIcon, Row, SecondaryButton, StrongPill, TextBtn } from '../components/ui';
+import { colors, space, type } from '../theme/tokens';
+import type { CompareResult, HabitRule, Role, RolePreview } from '../types';
+
+export function fmtTime(iso: string) {
+  const d = new Date(iso);
+  return isNaN(d.getTime()) ? iso : `${d.getMonth() + 1}/${d.getDate()} ${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
+}
+
+const isPlaceholder = (r: Role) => r.status === 'placeholder';
+
+export function Team({ roles, newIds, onOpen, onHire }: { roles: Role[]; newIds: string[]; onOpen: (id: string) => void; onHire: () => void }) {
+  return (
+    <View style={{ gap: space.xl }}>
+      <Text style={type.largeTitle}>瑙掕壊绠＄悊</Text>
+      <Group footer="杩欓噷绠＄悊涓轰綘鎻愪緵寤鸿鐨勮鑹诧紱鐏拌壊瑙掕壊鏆傛湭鍚敤銆? testID="role-list">
+        {roles.map((r) => {
+          const ph = isPlaceholder(r);
+          return (
+            <Row key={r.id} onPress={ph ? undefined : () => onOpen(r.id)} testID={`role-${r.id}`}>
+              <View style={g.hstack}>
+                <RoleIcon id={r.id} muted={ph} />
+                <Text style={[type.body, { fontWeight: '500' }, ph && { color: colors.text3 }]}>{r.name}</Text>
+                {newIds.includes(r.id) ? <StrongPill text="鏂颁笂宀? /> : null}
+                <View style={{ flex: 1 }} />
+                <Text style={[type.caption, !ph && { color: colors.text2 }]}>{ph ? '鏆傛湭鍚敤' : `宸插 ${r.learned_count} 鏉?鈥篳}</Text>
+              </View>
+              <Text style={[g.sub, { marginLeft: 28 }, ph && { color: colors.text3 }]} numberOfLines={1}>{r.duty}</Text>
+            </Row>
+          );
+        })}
+        <Row last onPress={onHire} testID="btn-hire">
+          <Text style={[type.body, { fontWeight: '600' }]}>锛?鎷涗竴涓柊绉樹功</Text>
+        </Row>
+      </Group>
+    </View>
+  );
+}
+
+function Diff({ before, after }: { before: string; after: string }) {
+  let p = 0; while (p < before.length && before[p] === after[p]) p++;
+  let s = 0; while (s < before.length - p && s < after.length - p && before[before.length - 1 - s] === after[after.length - 1 - s]) s++;
+  return <Text style={type.body}>{after.slice(0, p)}<Text style={{ fontWeight: '700' }}>{after.slice(p, after.length - s)}</Text>{after.slice(after.length - s)}</Text>;
+}
+
+export function RoleDetail({ role, rules, compare, onRevoke }: { role: Role | undefined; rules: HabitRule[]; compare: CompareResult | null; onRevoke: (id: string) => void }) {
+  if (!role) return <Text style={g.sub}>瑙掕壊涓嶅瓨鍦?/Text>;
+  const a = compare?.after.handoffs.find((x) => x.role === role.id);
+  const b = compare?.before.handoffs.find((x) => x.role === role.id);
+  return (
+    <View style={{ gap: space.xl }} testID="role-detail">
+      <View style={{ gap: 6 }}>
+        <View style={g.hstack}><RoleIcon id={role.id} size={28} /><Text style={type.largeTitle}>{role.name}</Text></View>
+        <Text style={g.sub}>{role.duty}</Text>
+        <Text style={type.caption}>涓嶅仛锛歿role.not_do}</Text>
+      </View>
+      <Group title="瀛﹀埌鐨勪範鎯? footer="涔犳儻浼氬湪瀹夊叏璋冩暣鍚庣敓鏁堬紱鎾ら攢鍚庝笅涓€娆℃暣鐞嗗洖鍒板師寤鸿銆? testID="habit-rules">
+        {rules.length === 0 ? <Row last><Text style={g.sub}>杩樻病瀛﹀埌涔犳儻銆傚湪浠婃棩鍗′笂鐐瑰紑鐭 鈫掋€屼笉鍚堥€傘€嶅憡璇夊畠鍘熷洜銆?/Text></Row>
+          : rules.map((r, i) => (
+            <Row key={r.id} last={i === rules.length - 1}>
+              <View style={[g.hstack, { justifyContent: 'space-between' }]}>
+                <Text style={[type.body, { fontWeight: '600', flex: 1 }]}>{r.text}</Text>
+                <TextBtn danger testID={`revoke-${r.key}`} label="鎾ら攢" onPress={() => onRevoke(r.id)} />
+              </View>
+              <Text style={g.sub}>{r.because.startsWith('鍥犱负') ? r.because : `鍥犱负浣犱笂娆¤銆?{r.because}銆峘}</Text>
+              <Text style={type.caption}>{fmtTime(r.learned_at)}</Text>
+            </Row>
+          ))}
+      </Group>
+      <Group title="涓婂懆 vs 杩欏懆" footer="鍚屼竴鐘舵€佽緭鍏ワ細涓婂懆 = 鏈涔犳椂锛涜繖鍛?= 搴旂敤宸插涔犳儻鍚庛€? testID="compare-view">
+        {a && b && a.action !== b.action ? (
+          <>
+            <Row><Text style={type.caption}>涓婂懆</Text><Text style={[type.body, { color: colors.text3, textDecorationLine: 'line-through' }]}>{b.action}</Text></Row>
+            <Row last><Text style={type.caption}>杩欏懆</Text><Diff before={b.action} after={a.action} /></Row>
+          </>
+        ) : <Row last><Text style={g.sub}>涓ゅ懆寤鸿涓€鑷达紙鏆傛棤鐢熸晥鐨勪範鎯級銆?/Text></Row>}
+      </Group>
+    </View>
+  );
+}
+
+export function Habits({ rules, roles, onOpen }: { rules: HabitRule[]; roles: Role[]; onOpen: (id: string) => void }) {
+  const name = (id: string) => roles.find((r) => r.id === id)?.name ?? id;
+  return (
+    <View style={{ gap: space.xl }}>
+      <Text style={type.largeTitle}>涔犳儻</Text>
+      <Group footer="鐐逛竴鏉¤繘鍏ョ涔﹁鎯咃紝鍙湅瀵规瘮銆佸彲鎾ら攢銆?>
+        {rules.length === 0 ? <Row last><Text style={g.sub}>杩樻病瀛﹀埌涔犳儻銆?/Text></Row>
+          : rules.map((r, i) => (
+            <Row key={r.id} last={i === rules.length - 1} onPress={() => onOpen(r.role)}>
+              <View style={g.hstack}><RoleIcon id={r.role} /><Text style={type.subhead}>{name(r.role)}</Text><View style={{ flex: 1 }} /><Text style={type.caption}>鈥?/Text></View>
+              <Text style={[type.body, { marginLeft: 28 }]}>{r.text}</Text>
+            </Row>
+          ))}
+      </Group>
+    </View>
+  );
+}
+
+export function Me({ onOpenTeam, onOpenHabits, onOpenClassic }: { onOpenTeam: () => void; onOpenHabits: () => void; onOpenClassic: () => void }) {
+  return (
+    <View style={{ gap: space.xl }}>
+      <Text style={type.largeTitle}>鎴戠殑</Text>
+      <Group>
+        <Row onPress={onOpenTeam} testID="tab-team"><Text style={type.body}>瑙掕壊绠＄悊</Text><Text style={type.caption}>鈥?/Text></Row>
+        <Row onPress={onOpenHabits} testID="tab-habits"><Text style={type.body}>涔犳儻</Text><Text style={type.caption}>鈥?/Text></Row>
+        <Row onPress={onOpenClassic} testID="open-classic"><Text style={type.body}>瀹屾暣璁板綍</Text><Text style={type.caption}>鈥?/Text></Row>
+        <Row last><Text style={type.body}>璐︽埛涓庡悓姝?/Text><Text style={type.caption}>鏆傛湭寮€鏀?/Text></Row>
+      </Group>
+      <Text style={[type.caption, { marginHorizontal: 4 }]}>闈炲尰鐤楀缓璁紱涓嶆壙璇哄噺閲嶆晥鏋?/Text>
+    </View>
+  );
+}
+
+type HireProps = {
+  step: 1 | 2 | 3; setStep: (s: 1 | 2 | 3) => void; need: string; setNeed: (n: string) => void;
+  preview: RolePreview | null; error: string | null; busy: boolean; onPreview: () => void; onConfirm: () => void;
+};
+
+export function HireFooter({ step, setStep, need, preview, error, busy, onPreview, onConfirm }: HireProps) {
+  if (step === 1) return <PrimaryButton testID="btn-hire-preview" label="棰勮瑙掕壊" loading={busy} disabled={!need.trim()} onPress={onPreview} />;
+  if (step === 2) return preview && !error ? <PrimaryButton testID="btn-hire-next" label="涓嬩竴姝? onPress={() => setStep(3)} /> : <SecondaryButton label="鎹釜闇€姹? onPress={() => setStep(1)} />;
+  return <PrimaryButton testID="btn-hire-confirm" label="纭涓婂矖" loading={busy} onPress={onConfirm} />;
+}
+
+/** 鎷涙柊绉樹功锛欳heckout 寮忓垎姝?1 璇撮渶姹?鈫?2 棰勮 鈫?3 纭 */
+export function HireFlow({ step, need, setNeed, preview, error }: HireProps) {
+  const steps = ['璇撮渶姹?, '棰勮瑙掕壊', '纭涓婂矖'];
+  return (
+      <View style={{ gap: space.xl }} testID="hire-panel">
+      <Text style={type.largeTitle}>鎷涗竴涓柊绉樹功</Text>
+      <View style={[g.hstack, { gap: 6 }]} testID="hire-steps">
+        {steps.map((t, i) => {
+        const n = i + 1; const on = n <= step;
+        return (
+          <React.Fragment key={t}>
+            <View style={{ width: 22, height: 22, borderRadius: 11, alignItems: 'center', justifyContent: 'center', backgroundColor: on ? colors.text : colors.surface }}>
+              <Text style={{ fontSize: 12, fontWeight: '600', color: on ? '#fff' : colors.text3 }}>{n}</Text>
+            </View>
+            <Text style={[type.subhead, !on && { color: colors.text3 }]}>{t}</Text>
+            {n < 3 ? <View style={{ flex: 1, height: 0.5, backgroundColor: colors.hairline }} /> : null}
+          </React.Fragment>
+        );
+        })}
+      </View>
+      {step === 1 ? (
+        <Group title="涓€鍙ヨ瘽璇翠綘缂轰粈涔? footer="鍙寜妯℃澘鎷涳紱鍖荤枟銆佸噺閲嶃€佹姇璧勭被涓嶆嫑銆?>
+        <Row last><TextInput testID="hire-input" value={need} onChangeText={setNeed} placeholder="姣斿锛氳繖鍛ㄩ挶绱? placeholderTextColor={colors.text3} style={g.input} /></Row>
+        </Group>
+      ) : null}
+      {step >= 2 ? (
+        <Group title={`闇€姹傦細${need}`} testID="hire-preview">
+        {error ? <Row last><Text style={g.sub} testID="hire-error">{error}</Text></Row> : preview ? (
+          <>
+            <Row><View style={g.hstack}><RoleIcon id={preview.id} /><Text style={[type.body, { fontWeight: '600' }]}>{preview.name}</Text></View></Row>
+            <Row><Text style={type.caption}>鑱岃矗</Text><Text style={type.body}>{preview.duty}</Text></Row>
+            <Row last={!preview.state_fields?.length}><Text style={type.caption}>涓嶅仛</Text><Text style={[type.body, { fontWeight: '600' }]}>{preview.not_do}</Text></Row>
+            {preview.state_fields?.length ? <Row last><Text style={type.caption}>鏂板鐘舵€?/Text><Text style={type.body}>{preview.state_fields.map((f) => f.label).join('銆?)}</Text></Row> : null}
+          </>
+        ) : null}
+        </Group>
+      ) : null}
+      {step === 3 ? <Text style={g.sub}>纭鍚庡畠浼氬嚭鐜板湪瑙掕壊绠＄悊鍜岃褰曞崱鐗囦腑锛涘彧鎻愪緵绠€鐭缓璁€?/Text> : null}
+    </View>
+  );
+}
