  const minW = Math.min(300, Math.max(13 * 15, reserve.length * 15));
  return (
    <View style={st.chatRow}>
      <View style={[st.avatar, l.struck && { backgroundColor: '#EDEDED' }]}>
        <RoleGlyph role={l.role} size={16} color={ink} />
