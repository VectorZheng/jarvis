/**
 * v0.3-draft: POST /v1/talk (SSE) 鈥?one sentence 鈫?tasks 鈫?per-task council stream.
 * Splitter: uses ../skills/rules/split.mjs if present (export splitText), else fallback below.
 */
import { randomUUID } from "node:crypto";
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { wantLine, sayLine, revisedLine } from "../skills/rules/lines.mjs";
import { proposeFollow } from "../skills/rules/follow.mjs";
import { bossAck, bossAsk, bossLine, bossRefuse } from "../skills/rules/boss.mjs";
import { polishSay, polishBoss, llmStatus } from "./llm.mjs";
import { loadSnapshot, mergeState } from "./health.mjs";

const DIR = path.dirname(fileURLToPath(import.meta.url));
const SPLIT_PATH = path.join(DIR, "../skills/rules/split.mjs");

const ICON = { fitness: "dumbbell", diet: "bowl", recovery: "moon", ledger: "wallet" };
const NAME = { fitness: "鍋ヨ韩鏁欑粌", diet: "楗椤鹃棶", recovery: "浣滄伅/鎭㈠绠″", ledger: "璁拌处绉樹功" };
const KW = [
  ["fitness", /缁億璺憒鍋ヨ韩|杩愬姩|绱瘄閿荤偧/],
  ["diet", /鍚億鍐扮|楗瓅鍋氬暐|鏅氶|鍗堥/],
  ["recovery", /鐫鐔|浣滄伅|浼戞伅/],
  ["ledger", /閽眧棰勭畻|鑺眧璁拌处|鐪?],
];
const FORBID = /璇婃柇|鑽瘄鍑忛噸|鍑忚偉\d|鐐掕偂|鐞嗚储|鎶曡祫|璐锋/;
const META_ACK = /浜у搧|鎶€鏈瘄鐮斿彂|宸ョ▼甯坾寮€浼?;
const CLARIFY_Q = "鑳藉啀璇村叿浣撲竴鐐瑰悧锛熶粖鏅氭槸鎯崇潯瑙夈€佸姩涓€鍔紝杩樻槸鍚冪偣鍟ワ紵";
function sanitizeBossLine(line, fallback) {
  const s = String(line || "").trim();
  if (!s || META_ACK.test(s)) return fallback;
  return s;
}


function fallbackSplit(text) {
  const segs = text.split(/鐒跺悗|椤轰究|杩樻湁|鍙﹀|锛寍,|銆倈锛泑;/).map((s) => s.trim()).filter(Boolean);
  const tasks = [];
  for (const s of segs) {
    if (s.length <= 2 && !/鐫缁億鍚億璺?.test(s)) continue; // drop tiny junk like銆屼綘鍔炪€?
    if (FORBID.test(s) || /浜у搧|鎶€鏈瘄鐮斿彂/.test(s)) {
      const kind = FORBID.test(s) ? "forbidden" : "off_health";
      tasks.push({ intent: "refuse", title: s, reason: bossRefuse(kind), kind });
      continue;
    }
    const hit = KW.find(([, re]) => re.test(s));
    tasks.push(hit ? { intent: hit[0], title: s } : { intent: "unknown", title: s });
  }
  return tasks.length ? tasks : [{ intent: "unknown", title: String(text).trim() || "锛堢┖锛? }];
}

async function getSplitter() {
  if (fs.existsSync(SPLIT_PATH)) {
    try {
      const m = await import(SPLIT_PATH + "?t=" + fs.statSync(SPLIT_PATH).mtimeMs);
      if (typeof m.splitText === "function") return m.splitText;
    } catch (e) { console.error("split.mjs load failed, fallback:", e.message); }
  }
  return fallbackSplit;
}


function taskHeadline(intent, card, st) {
  const h = (r) => card?.handoffs.find((x) => x.role === r)?.action || "";
  if (intent === "fitness") {
    const a = h("fitness");
    const m = Number((a.match(/(\d+)\s*鍒嗛挓/) || [])[1]);
    return `浠婃櫄鍙仛${Number.isFinite(m) ? m : ""}鍒嗛挓${/浣庡啿鍑粅鎷変几|韪忔/.test(a) ? "浣庡啿鍑? : "璁粌"}`;
  }
  if (intent === "diet") return /铔嬬倰楗?.test(h("diet")) ? "鍐扮铔嬬背锛屼竴纰楄泲鐐掗キ" : "鐢ㄥ啺绠辩幇鏈夐鏉愬悆涓€椤?;
  if (intent === "ledger") { const left = Number(st.budget_left); return Number.isFinite(left) ? `杩欓】0鍏冿紝鏈懆杩樺墿${left}` : "鍏堟姤鏈懆鍓╀綑棰勭畻"; }
  if (intent === "recovery") return "浠婃櫄鏃╃偣杩涙埧";
  return card?.headline || "";
}

const sessions = new Map(); // id -> {events:[], cancelled, pendingAsk:{ask_id, resolve}}

export function getSession(id) { return sessions.get(id); }

export function cancelSession(id) {
  const s = sessions.get(id);
  if (!s) return false;
  s.cancelled = true;
  s.pendingAsk?.resolve(null);
  return true;
}

export function replySession(id, ask_id, text) {
  const s = sessions.get(id);
  if (!s?.pendingAsk || s.pendingAsk.ask_id !== ask_id) return false;
  s.pendingAsk.resolve(String(text || ""));
  return true;
}

const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

/**
 * @param res  http response (SSE)
 * @param body {text, state?, session_id?}
 * @param deps {council}  council(body,{dryRun}) 鈫?card
 */
export async function runTalk(res, body, deps) {
  const session_id = body.session_id || randomUUID();
  const s = { events: [], cancelled: false, seq: 0 };
  sessions.set(session_id, s);
  res.writeHead(200, {
    "Content-Type": "text/event-stream; charset=utf-8",
    "Cache-Control": "no-cache",
    Connection: "keep-alive",
    "Access-Control-Allow-Origin": "*",
  });
  let closed = false;
  res.on("close", () => { closed = true; s.cancelled = true; s.pendingAsk?.resolve(null); });

  const pace = Number(body.pace_ms ?? 120);
  const emit = (event, data) => {
    if (closed) return;
    const ev = { session_id, seq: ++s.seq, ts: new Date().toISOString(), ...data };
    s.events.push({ event, data: ev });
    res.write(`event: ${event}\ndata: ${JSON.stringify(ev)}\n\n`);
  };
  const stop = () => {
    if (s.cancelled && !s.sentCancel) { s.sentCancel = true; emit("cancelled", { reason: "user" }); res.end(); }
    return s.cancelled;
  };

  const text = String(body.text || "").trim();
  emit("session.start", { text });
  if (!text) { emit("error", { code: "BAD_INPUT", message: "text required" }); emit("done", { tasks_ok: 0, tasks_failed: 0 }); return res.end(); }

  const split = await getSplitter();
  const raw = split(text).map((t) => ({ task_id: randomUUID().slice(0, 8), ...t }));
  emit("intent.split", { tasks: raw.map(({ task_id, intent, title }) => ({ task_id, intent, title })) });
  const liveForAck = raw.filter((t) => ["fitness", "diet", "recovery", "ledger"].includes(t.intent));
  const ackRoles = [...new Set(liveForAck.flatMap((t) => (t.intent === "fitness" ? ["fitness", "recovery"] : [t.intent])))];
  {
    const draftAck = bossAck(ackRoles);
    let line = draftAck;
    let source = "rule";
    // Only polish when real specialists are joining 鈥?empty ack must not invent銆屼骇鍝?鎶€鏈€?
    if (ackRoles.length) {
      const polished = await polishBoss({ kind: "ack", draft: draftAck, context: { roles: ackRoles } });
      line = sanitizeBossLine(polished.line, draftAck);
      source = line === draftAck ? "rule" : polished.source;
    }
    emit("boss.ack", { line, roles: ackRoles, speaker: "boss", source });
  }
  await sleep(pace);

  // state: client body.state > health snapshot > ask once (demo default on timeout/no answer)
  let state = mergeState(body.state, loadSnapshot());
  const needsCouncil = raw.some((t) => ["fitness", "diet", "recovery", "ledger"].includes(t.intent));
  if (needsCouncil && !(state && Number.isFinite(Number(state.sleep_hours)))) {
    const ask_id = randomUUID().slice(0, 8);
    emit("ask", { task_id: raw[0].task_id, ask_id, role: "recovery", speaker: "boss", question: bossAsk("sleep") });
    const answer = await new Promise((resolve) => {
      s.pendingAsk = { ask_id, resolve };
      setTimeout(() => resolve(null), Number(body.ask_timeout_ms ?? 8000));
    });
    s.pendingAsk = null;
    if (stop()) return;
    const sleepH = Number((answer || "").match(/(\d+(?:\.\d+)?)\s*(灏忔椂|h|涓挓)/)?.[1]);
    const mins = Number((answer || "").match(/(\d+)\s*(鍒嗛挓|min)/)?.[1]);
    state = {
      sleep_hours: Number.isFinite(sleepH) ? sleepH : 5,
      free_minutes: Number.isFinite(mins) ? mins : 40,
      fridge: ["egg", "rice"],
      _defaulted: !answer,
    };
  }

  if (needsCouncil && state) {
    if (!Array.isArray(state.fridge) || !state.fridge.length) state.fridge = ["egg", "rice"];
    if (!Number.isFinite(Number(state.free_minutes))) state.free_minutes = 40;
  }

  let card = null;
  if (needsCouncil) {
    const b = { ...state };
    if (raw.some((t) => t.intent === "ledger") && b.budget_left === undefined) b.budget_left = state.budget_left;
    try {
      card = deps.council(b, { dryRun: true, forceRoles: raw.map((t) => t.intent) });
    } catch (e) {
      emit("error", { code: "BAD_STATE", message: `鐘舵€佸瓧娈典笉鍏ㄦ垨鍐欓敊锛?{e.message}锛夛紝鎸変繚瀹堥粯璁ゅ€肩户缁璥 });
      state = { sleep_hours: 5, free_minutes: 40, fridge: ["egg", "rice"], budget_left: b.budget_left, _defaulted: true };
      try { card = deps.council({ ...state }, { dryRun: true, forceRoles: raw.map((t) => t.intent) }); }
      catch (e2) { emit("error", { code: "INTERNAL", message: String(e2.message || e2) }); emit("done", { tasks_ok: 0, tasks_failed: raw.length }); return res.end(); }
    }
  }

  let ok = 0, failed = 0;
  const rolesOf = (t) => (t.intent === "fitness" ? ["fitness", "recovery"] : [t.intent]);
  const live = raw.filter((t) => ["fitness", "diet", "recovery", "ledger"].includes(t.intent));
  // phase 1: every role.join first, so the split shows all droplets at once
  for (const t of live) for (const r of rolesOf(t)) emit("role.join", { task_id: t.task_id, role: r, name: NAME[r], icon: ICON[r] });
  await sleep(pace);
  for (const t of raw) {
    if (stop()) return;
    if (t.intent === "refuse") {
      const kind = t.kind === "forbidden" || /鍖荤枟|鍑忛噸|鎶曡祫|璇婃柇|鑽瘄鐞嗚储|璐锋/.test(t.reason || t.title || "")
        ? "forbidden"
        : "off_health";
      const line = bossRefuse(kind);
      emit("refuse", {
        task_id: t.task_id,
        title: t.title,
        reason: t.reason || line,
        speaker: "boss",
        boss_line: line,
      });
      emit("task.done", { task_id: t.task_id, status: "failed" }); failed++; continue;
    }
    if (t.intent === "unknown") {
      emit("ask", {
        task_id: t.task_id,
        ask_id: randomUUID().slice(0, 8),
        role: "system",
        speaker: "boss",
        question: CLARIFY_Q,
      });
      emit("task.done", { task_id: t.task_id, status: "degraded" }); failed++; continue;
    }
    const roles = rolesOf(t);
    const lines = {};
    const taskVetoes = (card?.vetoes_applied || []).filter((v) => roles.includes(v.to) && roles.includes(v.from));
    const vetoTargets = new Set(taskVetoes.map((v) => v.to));
    const say = async (role, short, full, marked, source) => {
      const line_id = randomUUID().slice(0, 8);
      lines[role] = line_id;
      const chunks = short.match(/.{1,6}/gu) || [short];
      for (let i = 0; i < chunks.length; i++) {
        if (stop()) return null;
        const payload = { task_id: t.task_id, role, line_id, delta: chunks[i], done: i === chunks.length - 1, short };
        if (i === chunks.length - 1 && full) payload.full = full;
        if (marked) payload.phase = marked; // "want" | "revised"
        if (i === chunks.length - 1 && source) payload.source = source;
        emit("role.say", payload);
        await sleep(pace / 3);
      }
      return line_id;
    };
    // 1) 鍘熶富寮狅紙浼氳鍚﹀喅鐨勮鑹插厛璇淬€屾兂瑕併€嶇増锛岄伩鍏嶅垝鎺夌殑灏辨槸缁撹锛?
    for (const r of roles) {
      if (!vetoTargets.has(r)) continue;
      const want = wantLine(r, state);
      if (!want) continue;
      const p = await polishSay({ role: r, phase: "want", draftShort: want.short, draftFull: want.full, state });
      await say(r, p.short, p.full || want.full, "want", p.source);
    }
    // 2) 鍏朵粬瑙掕壊姝ｅ父璇达紙鍚?recovery锛?
    for (const r of roles) {
      if (vetoTargets.has(r)) continue;
      const h = card?.handoffs.find((x) => x.role === r);
      if (!h) continue;
      const draft = sayLine(r, h.action, state);
      const p = await polishSay({ role: r, phase: "say", draftShort: draft, draftFull: h.action, state });
      await say(r, p.short, p.full || h.action, null, p.source);
    }
    // 3) 鍚﹀喅锛氬垝鎺夈€屾兂瑕併€嶉偅涓€琛?
    for (const v of taskVetoes) {
      emit("veto", { task_id: t.task_id, from: v.from, to: v.to, line_id: lines[v.to] || null, reason: `${NAME[v.from]}鎷︿簡${NAME[v.to]}锛?{v.reason}` });
      await sleep(pace);
    }
    // 4) 琚惁鍐崇殑瑙掕壊鍐嶅啋鏀硅繃鐨勪竴鍙ワ紙瀵归綈鍗＄墖鏍囬锛?
    for (const v of taskVetoes) {
      const h = card?.handoffs.find((x) => x.role === v.to);
      if (!h) continue;
      const draft = revisedLine(v.to, h.action, state);
      const p = await polishSay({ role: v.to, phase: "revised", draftShort: draft, draftFull: h.action, state });
      await say(v.to, p.short, p.full || h.action, "revised", p.source);
    }
    for (const a of card?.learned_applied || []) {
      if (roles.includes(a.role)) emit("habit.applied", { task_id: t.task_id, rule_id: a.id, text: `鎸変綘鐨勪範鎯敼浜嗭細${a.text}` });
    }
    const sub = card ? { ...card, headline: taskHeadline(t.intent, card, state), handoffs: card.handoffs.filter((h) => roles.includes(h.role)), vetoes_applied: card.vetoes_applied.filter((v) => roles.includes(v.to)) } : null;
    if (state?._defaulted && sub) { sub.defaulted = true; sub.disclaimer += "锛涚敤浜嗛粯璁ゅ€?; }
    if (sub) {
      sub.speaker = "boss";
      const draftLine = bossLine(sub.headline);
      const polished = await polishBoss({ kind: "line", draft: draftLine, context: { headline: sub.headline, intent: t.intent } });
      sub.boss_line = polished.line;
      sub.boss_line_source = polished.source;
    }
    emit("card.ready", { task_id: t.task_id, card: sub, speaker: "boss" });
    emit("task.done", { task_id: t.task_id, status: state?._defaulted ? "degraded" : "ok" });
    ok++;
    await sleep(pace);
  }
  if (stop()) return;
  if (ok > 0) {
    emit("follow.start", { status: "watching", hint: "璺熻繘涓?, plan: "浼氬悗鎸夌潯鐪?瀹屾垚鎯呭喌鑷姩鏀逛笅涓€鐗?, speaker: "boss" });
    const follow = proposeFollow(state || {}, card || {});
    if (follow?.updates?.length) {
      for (const u of follow.updates) {
        const parts = String(u.text || "").split("鈫?).map((s) => s.trim());
        emit("follow.update", {
          id: u.id || randomUUID().slice(0, 8),
          speaker: "boss",
          because: parts[0] || u.because,
          change: parts[1] || u.text,
          text: u.text,
          facts: u.facts || null,
          patch: u.patch || null,
          sources: ["council", "follow.mjs"],
        });
      }
    }
  }
  emit("done", { tasks_ok: ok, tasks_failed: failed });
  res.end();
  setTimeout(() => sessions.delete(session_id), 10 * 60 * 1000);
}


### app/src/talk/TalkScreen.tsx
import { Ionicons, MaterialCommunityIcons } from '@expo/vector-icons';
import React, { useCallback, useEffect, useMemo, useRef, useState, useSyncExternalStore } from 'react';
import { Animated, AppState, Platform, ScrollView, StyleSheet, Text, TextInput, View } from 'react-native';
import { Tap } from './press';
import { roleIcon } from '../types';
import { colors, radius, space, type } from '../theme/tokens';
import { DropStage, layoutDrops, useReduceMotion } from './Drops';
import { BossSkinPicker } from './BossSkinPicker';
import { HealthFollowPanel } from './HealthFollow';
import { loadHealthSnapshot, MOCK_SNAPSHOT, talkStateFromSnapshot, type HealthSnapshot } from './healthSnapshot';
import { loadBossSkinId, poolSource, resolveSkinUri, type BossSkinId } from './bossSkin';
import { hap } from './haptics';
import { MEETING_LINE, pickQuote } from './quotes';
import { startTalk } from './sseClient';
import type { TalkEvent } from './types';
import {
  SUGGEST_CHIPS,
  beginTalkSend,
  cancelTalkStream,
  clearTalkDraftBackup,
  clearTalkSendTimer,
  dispatchTalk,
  getTalkSession,
  getTalkStream,
  restoreTalkDraftOnFail,
  setTalkDraft,
  setTalkMinutesOpen,
  setTalkSrc,
  subscribeTalk,
  type Card,
  type Line,
} from './talkStore';

/** 浠嶅鍑猴紝渚涙祴璇?婕旂ず寮曠敤锛沀I 榛樿涓嶅啀棰勫～ */
export const DEMO_UTTERANCE = '浠婃櫄鎯崇粌涓€涓嬶紝椤轰究鐪嬬湅鍐扮鑳藉仛鍟ワ紝杩欏懆閽辩揣';

function useTalkSession() {
  return useSyncExternalStore(subscribeTalk, getTalkSession, getTalkSession);
}

/** 绾閫愬瓧锛氫笂涓€琛屾祦瀹屽啀寮€濮嬶紱绉帇瓒?3 琛屾暣琛岀洿鍑?*/
function useTypewriter(lines: Line[], frozen: boolean) {
  const [cur, setCur] = useState(0);
  const [chars, setChars] = useState(0);
  useEffect(() => {
    if (lines.length === 0) {
      setCur(0);
      setChars(0);
    }
  }, [lines.length === 0]);
  useEffect(() => {
    if (frozen) {
      setCur(lines.length);
      return;
    }
    if (cur >= lines.length) return;
    const l = lines[cur];
    if (lines.length - cur > 3) {
      setCur((c) => c + 1);
      setChars(0);
      return;
    }
    if (l.kind !== 'say') {
      if (chars === 0) {
        setChars(l.text.length);
        return;
      }
      const t = setTimeout(() => {
        setCur((c) => c + 1);
        setChars(0);
      }, l.kind === 'reason' ? 900 : l.kind === 'boss' ? 700 : 280);
      return () => clearTimeout(t);
    }
    if (chars < l.text.length) {
      const t = setTimeout(() => setChars((c) => c + 2), 30);
      return () => clearTimeout(t);
    }
    if (l.done) {
      setCur((c) => c + 1);
      setChars(0);
    }
  }, [lines, cur, chars, frozen]);
  const f = (i: number) => (i < cur ? -1 : i === cur ? chars : 0);
  return Object.assign(f, { cur });
}

export function TalkScreen({ onOpenClassic }: { onOpenClassic?: () => void } = {}) {
  const session = useTalkSession();
  const s = session.s;
  const text = session.draft;
  const [level, setLevel] = useState(0);
  const [width, setWidth] = useState(390);
  const [srcLocal, setSrcLocal] = useState(session.src);
  const rm = useReduceMotion();
  const scroll = useRef<ScrollView>(null);
  const shown = useTypewriter(s.lines, s.phase === 'stopped');
  const drops = useMemo(() => layoutDrops(s.drops, width), [s.drops, width]);
  const open = session.minutesOpen;
  const scrollToVeto = useCallback(() => {
    const go = () => {
      if (Platform.OS === 'web' && typeof document !== 'undefined') {
        const el = document.querySelector('[data-testid="veto-want"]') as HTMLElement | null;
        el?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        return;
      }
      scroll.current?.scrollTo({ y: 140, animated: true });
    };
    setTimeout(go, 60);
    setTimeout(go, 220);
  }, []);
  const [info, setInfo] = useState('');
  const curLine = s.lines[shown.cur];
  const speaking =
    s.phase === 'running' && curLine?.kind === 'say' && curLine.role !== 'jarvis'
      ? `${curLine.task_id}:${curLine.role}`
      : null;
  const [followOpen, setFollowOpen] = useState(false);
  const [skinOpen, setSkinOpen] = useState(false);
  const [skinId, setSkinId] = useState<BossSkinId>('default');
  const [uploadUri, setUploadUri] = useState<string | null>(null);
  const [healthSnap, setHealthSnap] = useState<HealthSnapshot>(MOCK_SNAPSHOT);
  useEffect(() => {
    (async () => {
      const id = await loadBossSkinId();
      setSkinId(id);
      if (id === 'upload') setUploadUri(await resolveSkinUri('upload'));
      setHealthSnap(await loadHealthSnapshot());
    })();
  }, []);
  const bossSkinSource = useMemo(() => {
    if (skinId === 'default') return null;
    if (skinId === 'upload') return uploadUri ? { uri: uploadUri } : null;
    return poolSource(skinId);
  }, [skinId, uploadUri]);
  const [quote, setQuote] = useState(() => pickQuote());
  const quoteOpacity = useRef(new Animated.Value(1)).current;
  const quotePhase = useRef(s.phase);
  const quoteBusy = useRef(false);
  const swapQuote = useCallback(() => {
    if (quoteBusy.current) return;
    quoteBusy.current = true;
    Animated.timing(quoteOpacity, { toValue: 0, duration: 200, useNativeDriver: true }).start(({ finished }) => {
      if (!finished) {
        quoteBusy.current = false;
        return;
      }
      setQuote((q) => pickQuote(q));
      Animated.timing(quoteOpacity, { toValue: 1, duration: 200, useNativeDriver: true }).start(() => {
        quoteBusy.current = false;
      });
    });
  }, [quoteOpacity]);
  useEffect(() => {
    quotePhase.current = s.phase;
    if (s.phase !== 'idle' && s.phase !== 'done') return;
    const id = setInterval(() => {
      const ph = quotePhase.current;
      if (ph === 'idle' || ph === 'done') swapQuote();
    }, 12000);
    return () => clearInterval(id);
  }, [s.phase, swapQuote]);
  const prevPhase = useRef(s.phase);
  useEffect(() => {
    const prev = prevPhase.current;
    prevPhase.current = s.phase;
    quotePhase.current = s.phase;
    if (s.phase === 'idle' && prev !== 'idle') swapQuote();
    if (s.phase === 'done' && (prev === 'running' || prev === 'asking' || prev === 'listening' || prev === 'following')) {
      swapQuote();
    }
  }, [s.phase, swapQuote]);
  useEffect(() => {
    const sub = AppState.addEventListener('change', (next) => {
      if (next !== 'active') return;
      const ph = quotePhase.current;
      if (ph === 'idle' || ph === 'done') swapQuote();
    });
    return () => sub.remove();
  }, [swapQuote]);
  const visibleCards = s.cards.filter((c) => c.afterLine <= shown.cur);
  const landed = new Set(visibleCards.map((c) => c.task_id));
  const folded = s.lines.filter(
    (l) =>
      (s.phase === 'done' || s.phase === 'stopped' ? true : l.task_id ? landed.has(l.task_id) : true) &&
      visibleCards.length > 0,
  );
  const foldedIds = new Set(folded.map((l) => l.id));
  const nSay = folded.filter((l) => l.kind === 'say').length;
  const nVeto = folded.filter((l) => l.kind === 'reason').length;

  // 鍒囬〉涓嶆帎娴侊細鍙竻鏈Е鍙戠殑瀹氭椂鍣紱涓嶅湪鍗歌浇鏃?cancelTalkStream
  useEffect(() => () => {
    clearTalkSendTimer();
  }, []);

  useEffect(() => {
    setSrcLocal(session.src);
  }, [session.src]);

  useEffect(() => {
    if (s.phase === 'done' || s.phase === 'stopped') {
      const t = setTimeout(() => scroll.current?.scrollTo({ y: 0, animated: true }), 400);
      return () => clearTimeout(t);
    }
  }, [s.phase]);

  const onTalkEvent = useCallback((e: TalkEvent) => {
    if (e.event === 'boss.ack') hap.soft();
    else if (e.event === 'role.join') hap.selection();
    else if (e.event === 'veto') hap.medium();
    else if (e.event === 'card.ready') hap.success();
    else if (e.event === 'follow.start') hap.light();
    else if (e.event === 'cancelled') hap.warning();
    else if (e.event === 'refuse' || e.event === 'ask') hap.soft();

    if (e.event === 'error') {
      restoreTalkDraftOnFail();
    } else if (e.event === 'cancelled') {
      clearTalkDraftBackup();
    } else if (
      e.event === 'session.start' ||
      e.event === 'intent.split' ||
      e.event === 'boss.ack' ||
      e.event === 'done'
    ) {
      clearTalkDraftBackup();
    }

    dispatchTalk({ type: 'ev', e });
    const st = getTalkStream();
    if (st?.source) setTalkSrc(st.source);
  }, []);

  const send = useCallback(() => {
    const t = text.trim();
    if (!t) return;
    hap.light();
    const state = healthSnap ? talkStateFromSnapshot(healthSnap) : undefined;
    beginTalkSend({
      text: t,
      startStream: (utterance, onEvent) => startTalk(utterance, onEvent, state),
      onEvent: onTalkEvent,
    });
  }, [text, healthSnap, onTalkEvent]);

  const applyChip = useCallback((chip: string) => {
    hap.selection();
    setTalkDraft(chip);
    setLevel((x) => x + 1);
  }, []);

  const running = s.phase === 'running' || s.phase === 'asking' || s.phase === 'listening';
  const showEmptyHints =
    (s.phase === 'idle' || s.phase === 'done') &&
    !text.trim() &&
    session.userBubbles.length === 0 &&
    s.lines.length === 0 &&
    s.cards.length === 0;

  return (
    <View style={{ flex: 1 }} testID="talk-screen">
      <View onLayout={(ev) => setWidth(ev.nativeEvent.layout.width)}>
        <DropStage
          width={width}
          phase={s.phase}
          level={level}
          pulse={s.pulse}
          drops={drops}
          speaking={speaking}
          falls={s.falls}
          reduce={rm}
          followHint={s.follow?.hint}
          bossSkin={bossSkinSource}
          onPressBoss={() => {
            if (s.phase === 'following' && s.follow) {
              hap.light();
              setFollowOpen(true);
            }
          }}
          onLongPressBoss={() => {
            hap.light();
            if (s.phase === 'idle' || s.phase === 'done' || s.phase === 'listening' || s.phase === 'following') {
              setSkinOpen(true);
            }
          }}
          onInfo={setInfo}
        />
        {s.phase === 'following' && s.follow ? (
          <Tap
            testID="follow-chip"
            feedback="light"
            onPress={() => setFollowOpen(true)}
            style={{ alignSelf: 'center', marginTop: 8, marginBottom: 4, paddingHorizontal: 12, paddingVertical: 6 }}
          >
            <Text style={[type.caption, { color: colors.text2 }]}>鈼?{s.follow.hint}</Text>
          </Tap>
        ) : s.phase === 'idle' || s.phase === 'done' || s.phase === 'listening' ? (
          <Animated.Text
            testID="boss-quote"
            numberOfLines={1}
            style={{
              alignSelf: 'center',
              marginTop: 16,
              maxWidth: width * 0.7,
              fontSize: 15,
              fontWeight: '400',
              lineHeight: 20,
              color: '#8E8E93',
              textAlign: 'center',
              opacity: quoteOpacity,
            }}
          >
            {quote}
          </Animated.Text>
        ) : s.phase === 'running' || s.phase === 'asking' ? (
          <Text
            testID="boss-meeting-line"
            style={{
              alignSelf: 'center',
              marginTop: 16,
              fontSize: 15,
              fontWeight: '400',
              lineHeight: 20,
              color: '#8E8E93',
              textAlign: 'center',
            }}
          >
            {MEETING_LINE}
          </Text>
        ) : null}
        {s.phase === 'idle' || s.phase === 'done' || s.phase === 'listening' || s.phase === 'following' ? (
          <Tap
            testID="btn-skin"
            feedback="light"
            onPress={() => setSkinOpen(true)}
            style={{
              alignSelf: 'center',
              marginTop: 10,
              paddingHorizontal: 14,
              paddingVertical: 7,
              borderRadius: 14,
              backgroundColor: colors.surface,
            }}
            accessibilityLabel="鎹㈠舰璞?
          >
            <Text style={{ fontSize: 13, fontWeight: '500', color: colors.text2 }}>鎹㈠舰璞?/Text>
          </Tap>
        ) : null}
        <Text testID="talk-debug" style={{ position: 'absolute', opacity: 0, fontSize: 1 }}>
          {info}
        </Text>
      </View>
      <ScrollView
        ref={scroll}
        style={{ flex: 1 }}
        contentContainerStyle={st.scroll}
        onContentSizeChange={() => {
          if (running) scroll.current?.scrollToEnd({ animated: true });
        }}
        showsVerticalScrollIndicator={false}
      >
        {showEmptyHints ? (
          <View style={st.chips} testID="suggest-chips">
            {SUGGEST_CHIPS.map((c) => (
              <Tap
                key={c}
                testID={`chip-${c}`}
                feedback="selection"
                onPress={() => applyChip(c)}
                style={st.chip}
              >
                <Text style={st.chipText}>{c}</Text>
              </Tap>
            ))}
          </View>
        ) : null}

        {session.userBubbles.map((b) => (
          <View key={b.id} style={st.userRow} testID="user-bubble">
            <View style={st.userBubble}>
              <Text style={st.userText}>{b.text}</Text>
            </View>
          </View>
        ))}

        {folded.length ? (
          <Tap
            testID="minutes-toggle"
            feedback="selection"
            onPress={() => {
              const next = !open;
              setTalkMinutesOpen(next);
              if (next) scrollToVeto();
            }}
            style={st.fold}
          >
            <Text style={type.subhead}>
              浼氳绾 路 {nSay} 鍙?路 {nVeto} 娆″惁鍐?
            </Text>
            <Ionicons name={open ? 'chevron-up' : 'chevron-down'} size={16} color={colors.text3} />
          </Tap>
        ) : null}
        {open
          ? folded.map((l) => {
              const tid =
                l.struck ? 'veto-want' : l.kind === 'reason' ? 'veto-reason' : l.phase === 'revised' ? 'veto-revised' : undefined;
              return (
                <View key={l.id} testID={tid} nativeID={tid}>
                  <MinuteLine l={l} />
                </View>
              );
            })
          : null}
        {s.lines.length > folded.length ? (
          <Text style={[st.section, folded.length ? { marginTop: space.md } : null]}>澶村ご 路 涓绘寔</Text>
        ) : null}
        {s.lines.map((l, i) => {
          if (foldedIds.has(l.id)) return null;
          const n = shown(i);
          return n === 0 ? null : <MinuteLine key={l.id} l={n < 0 ? l : { ...l, text: l.text.slice(0, n) }} />;
        })}
        {visibleCards.length ? <Text style={[st.section, { marginTop: space.lg }]}>澶村ご缁撹</Text> : null}
        {visibleCards.map((c) => (
          <ResultCard key={c.task_id} c={c} />
        ))}
        {s.follow && healthSnap ? (
          <HealthFollowPanel
            visible={followOpen}
            follow={s.follow}
            snapshot={healthSnap}
            reduceMotion={rm}
            onSnapshot={setHealthSnap}
            onClose={() => setFollowOpen(false)}
          />
        ) : null}
        {s.phase === 'done' ? (
          <Text style={[type.caption, { marginTop: space.md }]}>
            闈炲尰鐤楀缓璁?路 鏉ユ簮 {srcLocal === 'live' || session.src === 'live' ? '/v1/talk' : '鏈湴婕旂ず搴忓垪'}
          </Text>
        ) : null}
      </ScrollView>
      <View
        style={[
          st.bar,
          (s.phase === 'idle' || s.phase === 'listening' || s.phase === 'done') && { marginTop: 48 },
          s.phase === 'asking' && st.barLit,
        ]}
      >
        {/* P0锛氶害鍏嬮鏈疄鐜帮紝鍥炬爣鐩存帴闅愯棌 */}
        <TextInput
          testID="talk-input"
          value={text}
          onChangeText={(v) => {
            setTalkDraft(v);
            setLevel((x) => x + 1);
          }}
          placeholder={s.phase === 'asking' ? '鍥炴垜涓€鍙モ€? : '璺熸垜璇粹€?}
          placeholderTextColor={colors.text3}
          style={[st.input, { outlineStyle: 'none' } as never]}
          editable={!running || s.phase === 'asking'}
          onSubmitEditing={running ? undefined : send}
          returnKeyType="send"
          multiline
          maxLength={500}
          blurOnSubmit={false}
        />
        {running ? (
          <Tap
            testID="btn-stop"
            feedback="warning"
            pressOpacity={0.7}
            onPress={() => {
              cancelTalkStream();
            }}
            style={st.send}
            accessibilityLabel="鍋滄"
          >
            <View style={st.stopSq} />
          </Tap>
        ) : (
          <Tap
            testID="btn-send"
            feedback={false}
            pressOpacity={0.7}
            disabled={!text.trim()}
            onPress={send}
            style={[st.send, !text.trim() && { opacity: 0.28 }]}
            accessibilityLabel="鍙戦€?
          >
            <Ionicons name="arrow-up" size={18} color="#fff" />
          </Tap>
        )}
      </View>
      {onOpenClassic ? (
        <Tap
          testID="open-classic"
          feedback="selection"
          onPress={onOpenClassic}
          style={{ alignSelf: 'center', paddingVertical: 6, paddingBottom: 10 }}
        >
          <Text style={[type.caption, { color: colors.text3 }]}>鏃х増浠婃棩 鈥?/Text>
        </Tap>
      ) : null}
      <BossSkinPicker
        visible={skinOpen}
        current={skinId}
        uploadPreview={uploadUri}
        reduceMotion={rm}
        onClose={() => setSkinOpen(false)}
        onSelect={(id, uri) => {
          setSkinId(id);
          if (id === 'upload') setUploadUri(uri ?? null);
          if (id === 'default') setUploadUri(null);
        }}
      />
    </View>
  );
}

function RoleGlyph({ role, size, color }: { role?: string; size: number; color: string }) {
  if (role === 'jarvis') return <Ionicons name="diamond" size={size} color={color} />;
  if (role === 'fitness') return <Ionicons name="barbell" size={size} color={color} />;
  return <MaterialCommunityIcons name={roleIcon(role ?? '') as never} size={size} color={color} />;
}

function MinuteLine({ l }: { l: Line }) {
  if (l.kind === 'boss') {
    return (
      <View style={st.bossRow} testID="boss-ack">
        <Text style={st.bossText}>{l.text}</Text>
      </View>
    );
  }
  if (l.kind === 'reason' || l.kind === 'note') {
    return (
      <View style={st.sysRow}>
        <Text style={st.sysText}>{l.text}</Text>
      </View>
    );
  }
  if (l.kind === 'learned') {
    return (
      <View style={st.sysRow}>
        <Text style={[st.sysText, { color: colors.text2, fontWeight: '500' }]}>{l.text}</Text>
      </View>
    );
  }
  const name = (l.name ?? '').replace(/^.*\//, '');
  const [claim, basis] = l.text.split('锝?);
  const ink = l.struck ? colors.text3 : colors.text;
  const reserve = l.short && l.short.length > 0 ? l.short : l.text;
  const minW = Math.min(300, Math.max(13 * 15, reserve.length * 15));
  return (
    <View style={st.chatRow}>
      <View style={[st.avatar, l.struck && { backgroundColor: '#EDEDED' }]}>
        <RoleGlyph role={l.role} size={16} color={ink} />
      </View>
      <View style={{ flexShrink: 1, maxWidth: '100%' }}>
        <Text style={[type.caption, { color: l.struck ? colors.text3 : colors.text2, marginBottom: 3 }]}>{name}</Text>
        <View style={[st.bubble, l.struck && st.bubbleStruck, { minWidth: minW }]}>
          <Text style={[{ fontSize: 17, fontWeight: '400', lineHeight: 22, color: ink }, l.struck && st.struck]}>
            {l.kind === 'ask' ? <Text style={{ fontWeight: '600' }}>闂綘锛?/Text> : null}
            {claim}
            {basis !== undefined ? <Text style={{ color: l.struck ? colors.text3 : colors.text2 }}>锝渰basis}</Text> : null}
          </Text>
        </View>
      </View>
    </View>
  );
}

function ResultCard({ c }: { c: Card }) {
  const raw = c.card;
  const items = raw.items ?? (raw.handoffs ?? []).map((h) => ({ role: h.role, text: h.action ?? h.text ?? h.line ?? '' }));
  const learned = c.learned;
  const bossLine = raw.boss_line || `鎴戝府浣犲畾浜嗭細${raw.headline}`;
  const facts = raw.facts ?? [];
  return (
    <View style={st.card} testID={`card-${c.task_id}`}>
      <Text style={[type.subhead, { color: colors.text2 }]}>澶村ご</Text>
      <Text style={{ fontSize: 20, fontWeight: '600', lineHeight: 26, color: colors.text, marginTop: 4 }}>{bossLine}</Text>
      {c.title ? <Text style={[type.caption, { marginTop: 6 }]}>{c.title}</Text> : null}
      {facts.length ? (
        <View style={st.factsRow} testID={`card-facts-${c.task_id}`}>
          {facts.map((f, i) => (
            <View key={i} style={st.fact}>
              <Text style={st.factLabel}>{f.label}</Text>
              <Text style={st.factNum}>{f.value}</Text>
              {f.unit ? <Text style={st.factUnit}>{f.unit}</Text> : null}
            </View>
          ))}
        </View>
      ) : null}
      {items.map((it, i) => (
        <View key={i} style={st.cardRow}>
          <RoleGlyph role={it.role} size={16} color={colors.text} />
          <Text style={[type.body, { flex: 1 }]}>{it.text}</Text>
        </View>
      ))}
      {learned.length ? <Text style={st.learned}>杩欐瀛︿細浜嗭細{learned.join('锛?)}</Text> : null}
      {raw.defaulted ? <Text style={[type.caption, { marginTop: space.sm }]}>娌℃敹鍒颁綘鐨勭姸鎬侊紝鐢ㄤ簡榛樿鍊?/Text> : null}
    </View>
  );
}

