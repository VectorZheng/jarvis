const base = 'http://127.0.0.1:9302';
async function once() {
  const started = performance.now();
  const res = await fetch(base + '/v1/talk', {
    method: 'POST', headers: { 'content-type': 'application/json' },
    body: JSON.stringify({ text: '\\u8fd0\\u52a8', state: { sleep_hours: 7, free_minutes: 40, fridge: ['egg', 'rice'], budget_left: 300 }, pace_ms: 120 }),
  });
  const reader = res.body.getReader(); const decoder = new TextDecoder(); let buffer = '';
  let firstClaim = null, firstCard = null, previousSeq = 0, monotonic = true;
  for (;;) {
    const { value, done } = await reader.read(); if (done) break;
    buffer += decoder.decode(value, { stream: true }).replace(/\\r/g, '');
    for (;;) {
      const sep = buffer.indexOf('\\n\\n'); if (sep < 0) break;
      const block = buffer.slice(0, sep); buffer = buffer.slice(sep + 2);
      const data = block.split('\\n').filter(line => line.startsWith('data:')).map(line => line.slice(5).trim()).join('\\n');
      if ("'!data) continue;
      const event = JSON.parse(data); monotonic &&= event.seq > previousSeq; previousSeq = event.seq;
      if (event.line_id && firstClaim === null) firstClaim = performance.now() - started;
      if (event.card && firstCard === null) firstCard = performance.now() - started;
    }
  }
  return { firstClaim: Math.round(firstClaim), firstCard: Math.round(firstCard), seqMonotonic: monotonic, events: previousSeq };
}
const result = []; for (let i = 0; i < 3; i++) result.push(await once());
const cards = result.map(x => x.firstCard).sort((a,b)=>a-b);
console.log(JSON.stringify({ result, medianFirstCard: cards[1] }));
