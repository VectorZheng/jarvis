+    if (follow?.updates?.length) {
+      for (const u of follow.updates) {
+        const parts = String(u.text || "").split("→").map((s) => s.trim());
+        emit("follow.update", {
+          id: u.id || randomUUID().slice(0, 8),
+          speaker: "boss",
+          because: parts[0] || u.because,
+          change: parts[1] || u.text,
+          text: u.text,
+          patch: u.patch || null,
+          sources: ["council", "follow.mjs"],
+        });
