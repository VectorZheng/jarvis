@@ -0,0 +1,173 @@
+import { StatusBar } from 'expo-status-bar';
+import React, { useCallback, useEffect, useMemo, useState } from 'react';
+import { ScrollView, StyleSheet, View } from 'react-native';
+import { SafeAreaProvider, SafeAreaView, useSafeAreaInsets } from 'react-native-safe-area-context';
+import {
+  confirmRole, deleteRule, fetchCompare, fetchCouncil, fetchRoles, fetchRules, postFeedback, previewRole,
+  RejectError, type Sourced,
+} from './src/api/council';
+import { NavBar, PrimaryButton, TabBar, type TabKey } from './src/components/ui';
+import { useAndroidBack } from './src/hooks/useAndroidBack';
+import { Habits, HireFlow, HireFooter, Me, RoleDetail, Team } from './src/screens/Others';
+import { Today } from './src/screens/Today';
+import { TalkScreen } from './src/talk/TalkScreen';
+import { colors, space } from './src/theme/tokens';
+import {
+  DEMO_DEFAULTS, type CompareResult, type CouncilStatus, type HabitRule, type HandoffCardData, type Role, type RolePreview,
+} from './src/types';
+
+type Route = { name: 'detail'; roleId: string; from: TabKey } | { name: 'hire'; from: TabKey } | null;
+
+function DemoScene() {
+  const insets = useSafeAreaInsets();
+  const [tab, setTab] = useState<TabKey>('talk');
+  const [route, setRoute] = useState<Route>(null);
+  const [status, setStatus] = useState<CouncilStatus>({ ...DEMO_DEFAULTS });
+  const [roles, setRoles] = useState<Role[]>([]);
+  const [rules, setRules] = useState<HabitRule[]>([]);
+  const [card, setCard] = useState<Sourced<HandoffCardData> | null>(null);
+  const [compare, setCompare] = useState<CompareResult | null>(null);
+  const [loading, setLoading] = useState(false);
+  const [fallbackErr, setFallbackErr] = useState<string | null>(null);
+  const [feedbackRole, setFeedbackRole] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [hireStep, setHireStep] = useState<1 | 2 | 3>(1);
+  const [need, setNeed] = useState('');
+  const [preview, setPreview] = useState<RolePreview | null>(null);
+  const [hireErr, setHireErr] = useState<string | null>(null);
+  const [newIds, setNewIds] = useState<string[]>([]);
+
+  const labels = useMemo(() => Object.fromEntries(roles.map((r) => [r.id, r.name])), [roles]);
+  const hasBudget = roles.some((r) => r.id === 'ledger' || r.state_fields?.some((f) => f.key === 'budget_left'));
+  const note = (r: Sourced<unknown>) => { if (r.source === 'fallback') setFallbackErr(r.error ?? '接口失败'); };
+
+  const refreshMeta = useCallback(async () => {
+    const [ro, ru] = await Promise.all([fetchRoles(), fetchRules()]);
+    setRoles(ro.data); setRules(ru.data); note(ro); note(ru);
+    return ru.data;
+  }, []);
+  useEffect(() => { refreshMeta(); }, [refreshMeta]);
+
+  const runCouncil = useCallback(async (s: CouncilStatus, withCompare: boolean) => {
+    setLoading(true);
+    try {
+      const r = await fetchCouncil(s); setCard(r); note(r);
+      if (withCompare) { const c = await fetchCompare(s); setCompare(c.data); note(c); } else setCompare(null);
+    } finally { setLoading(false); }
+  }, []);
+
+  const onCouncil = () => { setFallbackErr(null); runCouncil(status, rules.length > 0); };
+  const onStatusChange = (next: CouncilStatus) => { setStatus(next); setCard(null); setCompare(null); };
+
+  const onFeedback = async (text: string) => {
+    if (!card || !feedbackRole) return;
+    setBusy(true);
+    try {
+      const r = await postFeedback(card.data.card_id, feedbackRole, text); note(r);
+      setFeedbackRole(null);
+      await refreshMeta();
+      await runCouncil(status, true);
+    } finally { setBusy(false); }
+  };
+
+  const onRevoke = async (id: string) => {
+    const r = await deleteRule(id); note(r);
+    const left = await refreshMeta();
+    void left; await runCouncil(status, true);
+  };
+
+  const onOpenRole = async (roleId: string) => {
+    setRoute({ name: 'detail', roleId, from: tab });
+    if (!compare && rules.length) { const c = await fetchCompare(status); setCompare(c.data); note(c); }
+  };
+
+  const openHire = () => { setHireStep(1); setNeed(''); setPreview(null); setHireErr(null); setRoute({ name: 'hire', from: tab }); };
+
+  const onPreview = async () => {
+    setBusy(true); setHireErr(null); setPreview(null);
+    try { const r = await previewRole(need.trim()); setPreview(r.data); note(r); }
+    catch (e) { setHireErr(e instanceof RejectError ? e.message : `预览失败：${e instanceof Error ? e.message : e}`); }
+    finally { setBusy(false); setHireStep(2); }
+  };
+
+  const onConfirm = async () => {
+    setBusy(true); setHireErr(null);
+    try {
+      const r = await confirmRole(need.trim()); note(r);
+      setNewIds((ids) => [...ids, r.data.id]);
+      await refreshMeta();
+      const next = { ...status, budget_left: status.budget_left ?? 300 };
+      setStatus(next);
+      setRoute(null); setTab('today');
+      await runCouncil(next, false);
+    } catch (e) { setHireErr(e instanceof RejectError ? e.message : `上岗失败：${e instanceof Error ? e.message : e}`); setHireStep(2); }
+    finally { setBusy(false); }
+  };
+
+  const learned = useMemo(() => {
+    if (!card) return null;
+    const r = rules.find((x) => card.data.handoffs.some((h) => h.role === x.role));
+    return r ? { role: r.role, text: r.text } : null;
+  }, [card, rules]);
+
+  const hireProps = { step: hireStep, setStep: setHireStep, need, setNeed, preview, error: hireErr, busy, onPreview, onConfirm };
+
+  // Android 返回键：招聘流程逐级退回，其余二级页面回上级；Tab 层不拦截（交给系统）
+  const onHardwareBack = useCallback(() => {
+    if (route?.name === 'hire' && hireStep > 1) {
+      setHireStep((hireStep - 1) as 1 | 2 | 3);
+      setHireErr(null);
+      return true;
+    }
+    if (route) {
+      setRoute(null);
+      setFeedbackRole(null);
+      return true;
+    }
+    return false;
+  }, [route, hireStep]);
+  useAndroidBack(!!route, onHardwareBack);
+
+  let body: React.ReactNode; let footer: React.ReactNode = null;
+  if (route?.name === 'detail') {
+    body = <RoleDetail role={roles.find((r) => r.id === route.roleId)} rules={rules.filter((r) => r.role === route.roleId)} compare={compare} onRevoke={onRevoke} />;
+  } else if (route?.name === 'hire') {
+    body = <HireFlow {...hireProps} />; footer = <HireFooter {...hireProps} />;
+  } else if (tab === 'today') {
+    body = <Today status={status} onChange={onStatusChange} hasBudget={hasBudget} card={card} labels={labels} learned={learned} onOpenRole={onOpenRole}
+      feedbackRole={feedbackRole} setFeedbackRole={setFeedbackRole} onFeedback={onFeedback} busy={busy} fallbackErr={fallbackErr} />;
+    footer = <PrimaryButton testID="btn-council" label="让秘书团会商" loading={loading} onPress={onCouncil} />;
+  } else if (tab === 'team') body = <Team roles={roles} newIds={newIds} onOpen={onOpenRole} onHire={openHire} />;
+  else if (tab === 'habits') body = <Habits rules={rules} roles={roles} onOpen={onOpenRole} />;
+  else body = <Me />;
+
+  const backLabel = route ? ({ talk: '说话', today: '今日', team: '秘书团', habits: '习惯', me: '我的' } as const)[route.from] : '';
+
+  return (
+    <SafeAreaView style={styles.safe} edges={['top', 'left', 'right']} testID="demo-scene">
+      <StatusBar style="dark" />
+      <View style={styles.col}>
+        {route ? <NavBar title={route.name === 'hire' ? '' : '秘书详情'} backLabel={backLabel} onBack={() => setRoute(null)} /> : null}
+        <View style={{ flex: 1, display: !route && tab === 'talk' ? 'flex' : 'none' }}>
+          <TalkScreen onOpenClassic={() => setTab('today')} />
+        </View>
+        {route || tab !== 'talk' ? <ScrollView style={{ flex: 1 }} contentContainerStyle={[styles.scroll, footer ? { paddingBottom: 140 + insets.bottom } : null]} keyboardShouldPersistTaps="handled" showsVerticalScrollIndicator={false}>
+          {body}
+        </ScrollView> : null}
+        {footer ? <View style={[styles.cta, route && { paddingBottom: Math.max(insets.bottom, space.sm) }]}>{footer}</View> : null}
+        {route || tab === 'talk' ? null : <TabBar value={tab} onChange={(k) => { setTab(k); setFeedbackRole(null); }} bottom={insets.bottom} />}
+      </View>
+    </SafeAreaView>
+  );
+}
+
+export default function App() {
+  return <SafeAreaProvider><DemoScene /></SafeAreaProvider>;
+}
+
+const styles = StyleSheet.create({
+  safe: { flex: 1, backgroundColor: colors.bg },
+  col: { flex: 1, maxWidth: 430, width: '100%', alignSelf: 'center' },
+  scroll: { paddingHorizontal: space.lg, paddingTop: space.md, paddingBottom: space.xl },
+  cta: { paddingHorizontal: space.lg, paddingTop: space.sm, paddingBottom: space.sm, backgroundColor: colors.bg },
+});
diff --git a/jarvis-app/src/talk/BossSkinPicker.tsx b/jarvis-app/src/talk/BossSkinPicker.tsx
new file mode 100644
index 0000000..c647ff7
--- /dev/null
+++ b/jarvis-app/src/talk/BossSkinPicker.tsx
@@ -0,0 +1,208 @@
+import { BlurView } from 'expo-blur';
+import * as ImagePicker from 'expo-image-picker';
+import React, { useEffect, useState } from 'react';
+import {
+  Animated, Image, Modal, Platform, ScrollView, StyleSheet, Text, View, useWindowDimensions,
+} from 'react-native';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+import { POOL_ITEMS, type BossSkinId, persistUpload, saveBossSkinId } from './bossSkin';
+import { hap } from './haptics';
+import { Tap } from './press';
+
+const LABEL = '#8E8E93';
+const INK = '#000000';
+const PREVIEW = 72;
+const GAP = 12;
+const PAD = 20;
+const RADIUS = 14;
+const DAMP = 0.86;
+
+type Props = {
+  visible: boolean;
+  current: BossSkinId;
+  uploadPreview?: string | null;
+  reduceMotion?: boolean;
+  onClose: () => void;
+  onSelect: (id: BossSkinId, uri?: string | null) => void;
+  /** 系统返回键入口：由上层挂进来，复用同一段收起动画 */
+  closeRef?: React.MutableRefObject<(() => void) | null>;
+};
+
+export function BossSkinPicker({ visible, current, uploadPreview, reduceMotion, onClose, onSelect, closeRef }: Props) {
+  const { height } = useWindowDimensions();
+  const insets = useSafeAreaInsets();
+  const sheetH = Math.min(height * 0.78, 640);
+  const [y] = useState(() => new Animated.Value(sheetH));
+
+  useEffect(() => {
+    if (!visible) return;
+    if (reduceMotion) {
+      y.setValue(0);
+      return;
+    }
+    y.setValue(sheetH);
+    Animated.spring(y, { toValue: 0, damping: DAMP * 20, stiffness: 180, mass: 0.9, useNativeDriver: true }).start();
+  }, [visible, sheetH, reduceMotion, y]);
+
+  const close = () => {
+    if (!reduceMotion) {
+      Animated.spring(y, { toValue: sheetH, damping: DAMP * 20, stiffness: 200, mass: 0.85, useNativeDriver: true }).start();
+    }
+    onClose();
+  };
+
+  useEffect(() => {
+    if (!closeRef) return;
+    closeRef.current = close;
+  });
+
+  const pickDefault = async () => {
+    hap.selection();
+    await saveBossSkinId('default');
+    onSelect('default', null);
+    close();
+  };
+
+  const pickPool = async (id: BossSkinId) => {
+    hap.selection();
+    await saveBossSkinId(id);
+    onSelect(id, null);
+    close();
+  };
+
+  const pickAlbum = async () => {
+    hap.selection();
+    const perm = await ImagePicker.requestMediaLibraryPermissionsAsync();
+    if (!perm.granted) return;
+    const mediaTypes = (ImagePicker as { MediaTypeOptions?: { Images: unknown } }).MediaTypeOptions?.Images ?? ['images'];
+    const res = await ImagePicker.launchImageLibraryAsync({
+      mediaTypes: mediaTypes as never,
+      allowsEditing: true,
+      aspect: [1, 1],
+      quality: 0.85,
+      exif: false,
+    });
+    if (res.canceled || !res.assets?.[0]?.uri) return;
+    const uri = await persistUpload(res.assets[0].uri);
+    onSelect('upload', uri);
+    close();
+  };
+
+  return (
+    <Modal visible={visible} transparent animationType="none" onRequestClose={close} testID="boss-skin-modal">
+      <View style={st.root}>
+        <Tap feedback="selection" style={st.dim} onPress={close} accessibilityLabel="关闭" pressOpacity={1} pressScale={1} />
+        <Animated.View style={[st.sheetWrap, { height: sheetH, transform: [{ translateY: y }] }]} testID="boss-skin-sheet">
+          {/* Android 不支持实时模糊：退化为半透明深色底，iOS 保持 BlurView */}
+          {Platform.OS === 'android' ? (
+            <View style={[StyleSheet.absoluteFill, st.blurFallback]} />
+          ) : (
+            <BlurView intensity={40} tint="light" style={StyleSheet.absoluteFill} />
+          )}
+          <View style={st.sheetInner}>
+            <View style={st.header}>
+              <View style={{ flex: 1 }}>
+                <Text style={st.title}>换形象</Text>
+                <Text style={st.sub}>本地保存 · 只改头头</Text>
+              </View>
+              <Tap testID="skin-close" feedback="selection" onPress={close} style={st.closeButton} accessibilityLabel="关闭换形象弹层">
+                <Text style={st.closeText}>×</Text>
+              </Tap>
+            </View>
+            <ScrollView style={st.optionsScroll} contentContainerStyle={[st.optionsContent, { paddingBottom: Math.max(28, insets.bottom + 20) }]} showsVerticalScrollIndicator={false} keyboardShouldPersistTaps="handled">
+            <Tap testID="skin-default" feedback={false} onPress={pickDefault} style={[st.row, current === 'default' && st.rowOn]}>
+              <View style={st.defaultOrb} />
+              <View style={{ flex: 1 }}>
+                <Text style={st.rowTitle}>默认球</Text>
+                <Text style={st.rowSub}>灰阶呼吸</Text>
+              </View>
+              {current === 'default' ? <Text style={st.check}>✓</Text> : null}
+            </Tap>
+
+            <Text style={st.section}>形象池</Text>
+            <View style={st.grid}>
+              {POOL_ITEMS.map((p) => {
+                const on = current === p.id;
+                return (
+                  <Tap
+                    key={p.id}
+                    testID={`skin-${p.id}`}
+                    feedback={false}
+                    onPress={() => pickPool(p.id)}
+                    style={[st.cell, on && st.cellOn]}
+                  >
+                    <Image source={p.source} style={st.preview} />
+                    <Text style={st.cellLabel}>{p.label}</Text>
+                  </Tap>
+                );
+              })}
+            </View>
+
+            <Tap testID="skin-upload" feedback={false} onPress={pickAlbum} style={[st.row, current === 'upload' && st.rowOn, { marginTop: 16 }]}>
+              {uploadPreview ? (
+                <Image source={{ uri: uploadPreview }} style={st.uploadThumb} />
+              ) : (
+                <View style={[st.defaultOrb, { backgroundColor: '#E5E5EA' }]}>
+                  <Text style={{ fontSize: 22, color: LABEL }}>＋</Text>
+                </View>
+              )}
+              <View style={{ flex: 1 }}>
+                <Text style={st.rowTitle}>从相册选图</Text>
+                <Text style={st.rowSub}>裁成圆 · 仅本机</Text>
+              </View>
+              {current === 'upload' ? <Text style={st.check}>✓</Text> : null}
+            </Tap>
+            </ScrollView>
+          </View>
+        </Animated.View>
+      </View>
+    </Modal>
+  );
+}
+
+const st = StyleSheet.create({
+  root: { flex: 1, justifyContent: 'flex-end' },
+  dim: { ...StyleSheet.absoluteFill, backgroundColor: 'rgba(0,0,0,0.18)' },
+  sheetWrap: {
+    borderTopLeftRadius: RADIUS,
+    borderTopRightRadius: RADIUS,
+    overflow: 'hidden',
+    backgroundColor: 'rgba(242,242,247,0.72)',
+  },
+  sheetInner: { flex: 1, paddingHorizontal: PAD, paddingTop: 12, paddingBottom: 8 },
+  header: { flexDirection: 'row', alignItems: 'center', paddingBottom: 14 },
+  optionsScroll: { flex: 1 },
+  optionsContent: { paddingBottom: 28 },
+  closeButton: { width: 44, height: 44, alignItems: 'center', justifyContent: 'center' },
+  closeText: { fontSize: 28, lineHeight: 32, color: INK },
+  blurFallback: { backgroundColor: 'rgba(0,0,0,0.5)' },
+  title: { fontSize: 20, fontWeight: '600', color: INK, letterSpacing: 0.2 },
+  sub: { fontSize: 13, fontWeight: '400', color: LABEL, marginTop: 4, marginBottom: 16 },
+  section: { fontSize: 13, fontWeight: '400', color: LABEL, marginTop: 18, marginBottom: 10 },
+  row: {
+    flexDirection: 'row', alignItems: 'center', gap: 14,
+    backgroundColor: '#FFFFFF', borderRadius: 12, paddingVertical: 12, paddingHorizontal: 14,
+  },
+  rowOn: { borderWidth: StyleSheet.hairlineWidth, borderColor: 'rgba(0,0,0,0.12)' },
+  rowTitle: { fontSize: 17, fontWeight: '400', color: INK },
+  rowSub: { fontSize: 13, fontWeight: '400', color: LABEL, marginTop: 2 },
+  check: { fontSize: 17, color: INK, fontWeight: '600' },
+  defaultOrb: {
+    width: 52, height: 52, borderRadius: 26, backgroundColor: '#C7C7CC',
+    borderWidth: StyleSheet.hairlineWidth * 2, borderColor: 'rgba(0,0,0,0.14)',
+    alignItems: 'center', justifyContent: 'center',
+  },
+  uploadThumb: { width: 52, height: 52, borderRadius: 26 },
+  grid: { flexDirection: 'row', flexWrap: 'wrap', gap: GAP },
+  cell: {
+    width: '47%' as unknown as number,
+    alignItems: 'center',
+    backgroundColor: '#FFFFFF',
+    borderRadius: 12,
+    paddingVertical: 14,
+    paddingHorizontal: 8,
+  },
+  cellOn: { borderWidth: StyleSheet.hairlineWidth, borderColor: 'rgba(0,0,0,0.14)' },
+  preview: { width: PREVIEW, height: PREVIEW, borderRadius: PREVIEW / 2 },
+  cellLabel: { marginTop: 8, fontSize: 13, fontWeight: '400', color: LABEL },
+});
diff --git a/jarvis-app/src/talk/TalkScreen.tsx b/jarvis-app/src/talk/TalkScreen.tsx
