+++ b/jarvis-app/src/talk/TalkScreen.tsx
@@ -0,0 +1,604 @@
+import { Ionicons, MaterialCommunityIcons } from '@expo/vector-icons';
+import React, { useCallback, useEffect, useMemo, useReducer, useRef, useState } from 'react';
+import { Animated, AppState, Image, KeyboardAvoidingView, Platform, Pressable, ScrollView, StyleSheet, Text, TextInput, View } from 'react-native';
+import { useSafeAreaInsets } from 'react-native-safe-area-context';
+import { Tap } from './press';
+import { roleIcon } from '../types';
+import { useAndroidBack } from '../hooks/useAndroidBack';
+import { colors, radius, space, type } from '../theme/tokens';
+// 主视觉球体（DropStage）已替换为拟人化角色；Drops.tsx 本身保留，这里只复用阶段类型与 reduce-motion
+import { useReduceMotion, type Drop, type Phase } from './Drops';
+import { JarvisAvatar, type JarvisMood } from './JarvisAvatar';
+import { BossSkinPicker } from './BossSkinPicker';
+import { HealthFollowPanel } from './HealthFollow';
+import { loadHealthSnapshot, MOCK_SNAPSHOT, talkStateFromSnapshot, type HealthSnapshot } from './healthSnapshot';
+import { loadBossSkinId, poolSource, resolveSkinUri, type BossSkinId } from './bossSkin';
+import { hap } from './haptics';
+import { MEETING_LINE, pickQuote } from './quotes';
+import { sanitizeBossLine } from './sanitizeBossLine';
+import { startTalk } from './sseClient';
+import type { TalkCard, TalkEvent, TalkStream } from './types';
+
+export const DEMO_UTTERANCE = '今晚想练一下，顺便看看冰箱能做啥，这周钱紧';
+
+/** 主视觉占位：沿用旧球体 stage 的高度，240×340 的角色刚好落进去 */
+const HERO_H = 340;
+const AVATAR_W = 240;
+const AVATAR_H = 340;
+/** 自定义形象仍按旧球体最大直径的圆形展示 */
+const SKIN_D = 260;
+
+type Line = { id: string; kind: 'user' | 'say' | 'reason' | 'ask' | 'learned' | 'note' | 'boss'; role?: string; name?: string; text: string; short?: string; struck?: boolean; done: boolean; task_id?: string; phase?: 'want' | 'revised' };
+type Card = { task_id: string; title: string; card: TalkCard; learned: string[]; afterLine: number; speaker?: string };
+type Follow = { hint: string; plan: string; updates: { id: string; because: string; change: string; text?: string; facts?: { sleep_hours?: number } }[] };
+type S = {
+  phase: Phase; titles: Record<string, string>; names: Record<string, string>;
+  drops: Drop[]; lines: Line[]; cards: Card[]; learned: Record<string, string[]>; falls: number; pulse: number; follow: Follow | null;
+};
+const init: S = { phase: 'idle', titles: {}, names: {}, drops: [], lines: [], cards: [], learned: {}, falls: 0, pulse: 0, follow: null };
+const note = (id: string, text: string, kind: Line['kind'] = 'note', task_id?: string): Line => ({ id, kind, text, done: true, task_id });
+
+/** 事件 → 状态。动画只由这里的状态变化触发，不按时间轴自播 */
+function reduce(s: S, a: { type: 'submit'; text: string } | { type: 'failed' } | { type: 'reset' } | { type: 'listen' } | { type: 'ev'; e: TalkEvent }): S {
