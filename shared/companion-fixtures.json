  "idempotencyScenario": {
    "id": "duplicate-event-command-and-ack-never-write-twice",
    "initialRevision": 0,
    "command": {
      "schemaVersion": 1, "opId": "synthetic-op-note-a", "kind": "note.create",
      "payload": { "text": "合成幂等笔记", "source": "manual_text" }, "observationIds": []
    },
    "committedEvent": {
      "schemaVersion": 1, "eventId": "synthetic-event-note-a", "opId": "synthetic-op-note-a",
      "revision": 1, "occurredAt": 1700000000100,
      "change": {
        "kind": "upsert",
        "record": {
          "schemaVersion": 1, "id": "synthetic-note-a", "revision": 1,
          "kind": "note", "text": "合成幂等笔记", "source": { "kind": "manual_text" },
          "status": "confirmed", "createdAt": 1700000000100, "updatedAt": 1700000000100,
          "lastSeenAt": null, "observationIds": []
        }
      }
    },
    "expectedReceipt": {
      "schemaVersion": 1, "opId": "synthetic-op-note-a", "eventId": "synthetic-event-note-a",
      "revision": 1, "recordIds": ["synthetic-note-a"], "committedAt": 1700000000100, "replayed": false
    },
    "steps": [
      { "operation": "submitCommand", "use": "command", "expectedRevision": 1, "expectedRecords": 1, "expectedReplayed": false },
      { "operation": "submitCommand", "use": "command", "expectedRevision": 1, "expectedRecords": 1, "expectedReplayed": true, "expectedEventId": "synthetic-event-note-a" },
      { "operation": "deliverEvent", "use": "committedEvent", "expectedProjectedRecords": 1, "expectedDatabaseWrites": 0 },
      { "operation": "deliverEvent", "use": "committedEvent", "expectedProjectedRecords": 1, "expectedDatabaseWrites": 0 },
      { "operation": "ackChanges", "revision": 1, "expectedAckedRevision": 1, "expectedRevision": 1, "expectedRecords": 1 },
      { "operation": "ackChanges", "revision": 1, "expectedAckedRevision": 1, "expectedRevision": 1, "expectedRecords": 1 },
      { "operation": "ackChanges", "revision": 0, "expectedAckedRevision": 1, "expectedRevision": 1, "expectedRecords": 1 },
      { "operation": "ackChanges", "revision": 2, "expectedErrorCode": "INVALID_REVISION", "expectedRevision": 1 },
      { "operation": "submitCommand", "use": "command", "payloadPatch": { "text": "不同的合成笔记" }, "expectedErrorCode": "OP_ID_CONFLICT", "expectedRevision": 1, "expectedRecords": 1 }
    ]
  }
