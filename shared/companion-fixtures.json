{
  "schemaVersion": 1,
  "fixtureFormatVersion": 1,
  "synthetic": true,
  "conventions": {
    "scope": "仅合成协议/裁决数据，不包含真实密钥、用户信息、录音、照片或实际网络请求。不是测试执行结果。",
    "isolation": "除 idempotencyScenario 内的连续步骤外，各 case 独立运行并重置 Repository。",
    "modelCases": "output 是完整 VisionModelOutput；假上游以 finish_reason=stop 返回 JSON.stringify(output)。原生只在 schema 校验通过后按 nativeContext 裁决。",
    "defaults": "metadata 和 nativeContext 为默认值；每个 case 的 metadataOverride/contextOverride 仅作顶层覆盖，不递归合并。",
    "references": "variantCases 的 modelCaseId 引用 modelCases.id；先深复制该 output，再将 observationPatch 顶层字段替换到 observations[0]，不修改原样本。",
    "expectations": "expected.records 只列需要断言的字段，不是完整 LifeRecord。executedActions 必须始终为 0。",
    "upstream": "upstreamCases.rawContent 原样返回，不能 JSON.stringify 或修复；finishReason 映射到上游 finish_reason。",
    "transport": "transportBoundaryCases 是长度/元数据边界描述，由 Verify 生成对应合成字节，不冒充完整可解码 JPEG/音频。"
  },
