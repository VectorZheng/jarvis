{
  "expo": {
    "name": "随身助手",
    "slug": "jarvis-secretary",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jarvis.secretary",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "连接同一网络中的电脑，获取对话回复和测试服务。",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2F2F7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jarvis.secretary",
      "allowBackup": false,
      "blockedPermissions": ["android.permission.ACCESS_BACKGROUND_LOCATION", "android.permission.FOREGROUND_SERVICE_LOCATION", "android.permission.FOREGROUND_SERVICE_MICROPHONE"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      ["expo-secure-store", { "configureAndroidBackup": false }],
      ["expo-location", { "locationWhenInUsePermission": "仅在你主动记录位置时获取一次位置。", "locationAlwaysAndWhenInUsePermission": false, "locationAlwaysPermission": false, "motionUsagePermission": false, "isIosBackgroundLocationEnabled": false, "isAndroidBackgroundLocationEnabled": false, "isAndroidForegroundServiceEnabled": false, "isAndroidMotionActivityEnabled": false }],
      ["expo-dev-client", { "launchMode": "most-recent" }],
      "./plugins/withCompanion",
      ["expo-audio", { "microphonePermission": "仅在前台按下录音时录制语音，转写后由你确认发送。", "enableBackgroundPlayback": false, "enableBackgroundRecording": false }],
      [
        "expo-image-picker",
        {
          "photosPermission": "换头头形象时需要访问相册",
          "cameraPermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c7cbb201-01a3-4f0a-91a9-bb72a80310ca"
      }
    },
    "owner": "vector6"
  }
}
