{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "JARVIS_BUILD_ENV": "development"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "JARVIS_BUILD_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
