<data-extraction-rules>
  <cloud-backup disableIfNoEncryptionCapabilities="true">
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="SecureStore" />
    <exclude domain="sharedpref" path="jarvis-overlay.xml" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="SecureStore" />
    <exclude domain="sharedpref" path="jarvis-overlay.xml" />
  </device-transfer>
</data-extraction-rules>
